# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# .env.local is git-ignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public key used in the browser (anon key, or the newer "publishable" sb_publishable_... key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key with full database access (service_role key, or the newer "secret" sb_secret_... key).
# Used by the /api route handlers and `npm run admin:create`. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App URL: used in emails, WhatsApp join links and auth redirects.
# Production: https://learn.mental-wellness.live
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (SMTP). The app sends EVERY learner email through this account: activation
# and sign-in links, class reminders and updates. Until these are set, the interest
# form answers 503. Port 465 = SSL, 587 = STARTTLS.
# (Gmail / Google Workspace: smtp.gmail.com, port 465, an App Password as SMTP_PASS.)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Everyday Mental Wellness <welcome@mental-wellness.live>"

# ---------------------------------------------------------------------------
# Razorpay: Dashboard → Account & Settings → API Keys (use test keys first)
# Webhook: Dashboard → Webhooks → URL <APP_URL>/api/webhooks/razorpay,
# events payment.captured, payment.failed, order.paid, and a secret of your choice.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API: Meta for Developers → your app → WhatsApp → API Setup
# Use a permanent System User token. Template names must match approved templates.
# OFF at launch: everything goes by email. Set WHATSAPP_ENABLED=true (with the keys)
# to confirm numbers by WhatsApp code and send the 2-minute reminder on WhatsApp.
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_OTP=emw_verification_code
WHATSAPP_TEMPLATE_CLASS_REMINDER=emw_class_starting
# Secret used to hash phone confirmation codes (any long random string)
PHONE_CODE_SECRET=

# ---------------------------------------------------------------------------
# LiveKit: Cloud project → Settings → Keys. LIVEKIT_URL is the wss:// project URL.
# Webhook: Settings → Webhooks → <APP_URL>/api/webhooks/livekit (signed with the API key)
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# cron-job.org: every job sends the header  Authorization: Bearer <CRON_SECRET>
#   <APP_URL>/api/cron/reminders  every 1 minute
#   <APP_URL>/api/cron/sessions   every 5 minutes
# ---------------------------------------------------------------------------
CRON_SECRET=
